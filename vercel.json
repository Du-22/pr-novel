{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "build",
  "routes": [
    { "handle": "filesystem" },
    { "src": "^/novel/[^/]+/read/[^/]+/[^/]+$", "dest": "/index.html" },
    { "src": "^/novel/[^/]+/read/[^/]+$", "dest": "/index.html" },
    { "src": "^/novel/[^/]+$", "dest": "/index.html" },
    { "src": "^/ranking(?:/(?:views|favorites|new))?$", "dest": "/index.html" },
    { "src": "^/tags$", "dest": "/index.html" },
    { "src": "^/upload$", "dest": "/index.html" },
    { "src": "^/my-uploads$", "dest": "/index.html" },
    { "src": "^/my-uploads/edit/[^/]+$", "dest": "/index.html" },
    { "src": "^/my-uploads/edit/[^/]+/chapter/[^/]+$", "dest": "/index.html" },
    { "src": "^/my-uploads/edit/[^/]+/v/[^/]+/chapter/[^/]+$", "dest": "/index.html" },
    { "src": "^/profile(?:/(?:favorites|works|history))?$", "dest": "/index.html" },
    { "src": "^/search$", "dest": "/index.html" },
    { "src": "^/notifications$", "dest": "/index.html" },
    { "src": "^/user/[^/]+$", "dest": "/index.html" },
    { "src": "^/auth$", "dest": "/index.html" },
    { "src": "^/admin$", "dest": "/index.html" },
    { "src": "/.*", "status": 404, "dest": "/index.html" }
  ]
}
