// ============================================
// Firebase Storage Security Rules
// 用途: 管控封面圖片與小說 TXT 的讀寫權限
// ============================================

rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isAdmin() {
      return request.auth != null
             && request.auth.uid == "gFwOsNadC9MoPzPdrn85H09AtVt2";
    }

    function novelIsPublic(novelId) {
      return firestore.get(/databases/(default)/documents/novels/$(novelId)).data.isHidden == false;
    }

    // 封面圖片：所有人可讀，只有本人可寫
    match /covers/{userId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // 小說章節 TXT：公開小說可讀，隱藏小說只有管理員可讀。
    match /novels/{novelId}/{path=**} {
      allow read: if isAdmin() || novelIsPublic(novelId);
      allow write: if request.auth != null
                   && firestore.get(/databases/(default)/documents/novels/$(novelId)).data.authorUid == request.auth.uid
                   && novelIsPublic(novelId);
    }
  }
}
